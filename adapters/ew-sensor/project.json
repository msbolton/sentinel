{
  "name": "ew-sensor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "adapters/ew-sensor",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/adapters/ew-sensor"],
      "options": {
        "commands": ["cd adapters/ew-sensor && CGO_ENABLED=0 go build -o ../../dist/adapters/ew-sensor/ew-sensor ./cmd/ew-sensor"],
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cd adapters/ew-sensor && go test -v -race ./..."],
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
