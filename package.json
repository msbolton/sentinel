{
  "name": "@sentinel/source",
  "version": "0.0.1",
  "private": true,
  "description": "SENTINEL - Geospatial Intelligence Platform",
  "scripts": {
    "start": "nx run-many --target=serve --projects=client,api-gateway",
    "start:client": "nx serve client",
    "start:api": "nx serve api-gateway",
    "build": "nx run-many --target=build --all",
    "build:client": "nx build client",
    "build:api": "nx build api-gateway",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "proto:generate": "make proto",
    "docker:infra": "docker-compose -f docker-compose.infra.yml up -d",
    "docker:all": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test:go": "make test-go"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@bufbuild/buf": "^1.66.1",
    "@google/model-viewer": "^4.2.0",
    "cesium": "^1.120.0",
    "d3": "^7.9.0",
    "keycloak-js": "^24.0.0",
    "long": "^5.3.2",
    "rxjs": "^7.8.1",
    "satellite.js": "^7.1.0",
    "three": "^0.182.0",
    "ts-proto": "^1.180.0",
    "vis-network": "^9.1.9",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@nx/angular": "^20.0.0",
    "@nx/eslint-plugin": "^20.0.0",
    "@nx/jest": "^20.8.4",
    "@nx/js": "^20.0.0",
    "@nx/workspace": "^20.0.0",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^16.1.1",
    "nx": "^20.0.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.6.0"
  },
  "nx": {}
}
