# SENTINEL Environment Configuration
# Copy to .env and adjust values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=sentinel
DB_USERNAME=sentinel
DB_PASSWORD=sentinel_dev

# Kafka
KAFKA_BROKERS=localhost:9092

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-web
KEYCLOAK_API_CLIENT_ID=sentinel-api
KEYCLOAK_SERVICE_CLIENT_ID=sentinel-service
KEYCLOAK_SERVICE_CLIENT_SECRET=sentinel-service-secret-dev

# Mail (MailHog in dev)
MAIL_HOST=localhost
MAIL_PORT=1025

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123

# GeoServer
GEOSERVER_URL=http://localhost:8600/geoserver

# CesiumJS
CESIUM_ION_ACCESS_TOKEN=

# OpenSky credentials, referenced by the built-in opensky feed (secretRefs env:OPENSKY_CLIENT_*).
# Poll interval, viewport lease and credit settings live in the feed's config
# (GET/PATCH /api/v1/feeds/opensky); enable the feed with POST /api/v1/feeds/opensky/enable.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# aisstream.io API key (free account at https://aisstream.io), referenced by the built-in
# aisstream feed (secretRefs apiKey: env:AISSTREAM_API_KEY). Enable the feed with
# POST /api/v1/feeds/aisstream/enable; it streams vessels over the map viewports.
AISSTREAM_API_KEY=

# TCP/UDP connections that external systems send to are served by the
# ingest listener (docker compose --profile inbound up -d), which uses the
# host's network. INGEST_LISTENER_HOST is the address senders use, shown in
# each connection's send guide. INGEST_RESERVED_PORTS overrides the ports
# listeners may not take (default: the stack's own published ports).
INGEST_LISTENER_HOST=localhost
INGEST_RESERVED_PORTS=

# Ingest Service
# Postgres feed registry
DATABASE_URL=postgres://sentinel:sentinel_dev@localhost:5432/sentinel?sslmode=disable
# Shared secret the api-gateway presents to the ingest management API (required in production)
INGEST_SERVICE_TOKEN=dev-ingest-token
# Built-in feeds to insert enabled when the feeds table does not have them yet, e.g. opensky,celestrak
FEEDS_BOOTSTRAP_ENABLED=

# Service Ports
API_GATEWAY_PORT=3000
ENTITY_SERVICE_PORT=3001
TRACK_SERVICE_PORT=3002
SEARCH_SERVICE_PORT=3003
LINK_ANALYSIS_SERVICE_PORT=3004
ALERT_SERVICE_PORT=3005
INGEST_SERVICE_PORT=4000
# Host port for the analytics container; macOS AirPlay Receiver listens on 5000, so use 5001 there.
ANALYTICS_SERVICE_PORT=5000
WEB_PORT=4200

# GeoServer (config/geoserver/provision.sh): read-only database role and the
# per-clearance GIS accounts gis-u, gis-c, gis-s, gis-ts
GIS_DB_PASSWORD=sentinel_gis_dev
GIS_USER_PASSWORD_U=gis-u-dev
GIS_USER_PASSWORD_C=gis-c-dev
GIS_USER_PASSWORD_S=gis-s-dev
GIS_USER_PASSWORD_TS=gis-ts-dev
