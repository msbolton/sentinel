{
  "name": "proto-gen",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/proto-gen/src",
  "projectType": "library",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make proto",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make proto-check",
        "cwd": "."
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/proto-gen",
        "main": "libs/proto-gen/src/index.ts",
        "tsConfig": "libs/proto-gen/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/proto-gen"],
      "options": {
        "jestConfig": "libs/proto-gen/jest.config.ts"
      }
    },
    "test-go": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cd libs/proto-gen/src/go && go test -race ./..."],
        "cwd": "{workspaceRoot}"
      }
    },
    "test-python": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cd libs/proto-gen/src/python && PYTHONPATH=. python3 -m pytest -q tests"],
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
