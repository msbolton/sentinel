{
  "name": "api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-gateway",
  "projectType": "application",
  "tags": ["scope:api-gateway", "type:gateway"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api-gateway"],
      "options": {
        "commands": [
          "cd apps/api-gateway && CGO_ENABLED=1 go build -o ../../dist/apps/api-gateway/server ./cmd/server"
        ],
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cd apps/api-gateway && AUTH_DEV_BYPASS=true go run ./cmd/server"],
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cd apps/api-gateway && go vet ./... && go test -race ./..."],
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
