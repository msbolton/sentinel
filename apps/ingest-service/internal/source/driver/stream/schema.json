{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/stream.json",
  "title": "Message stream",
  "description": "Bytes arrive over a transport, a framer splits them, and a decoder turns each frame into observations.",
  "type": "object",
  "required": ["transport", "decoder"],
  "properties": {
    "transport": {
      "type": "object",
      "title": "Transport",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["tcpclient", "tcpserver", "udp", "mqtt", "stomp", "websocket"], "title": "Kind" },
        "address": { "type": "string", "minLength": 1, "title": "Address", "description": "tcpclient: host:port to connect to; tcpserver/udp: host:port to bind, e.g. :4001" },
        "url": { "type": "string", "pattern": "^wss?://", "title": "WebSocket URL" },
        "brokerUrl": { "type": "string", "minLength": 1, "title": "Broker URL", "description": "mqtt: tcp://host:1883 or ssl://host:8883; stomp: host:61613" },
        "topics": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "title": "MQTT topics" },
        "qos": { "type": "integer", "minimum": 0, "maximum": 2, "default": 1, "title": "MQTT QoS" },
        "clientId": { "type": "string", "title": "MQTT client id" },
        "queue": { "type": "string", "minLength": 1, "title": "STOMP queue" },
        "username": { "type": "string", "title": "Username", "description": "The password comes from secretRefs.password." },
        "maxFrameBytes": { "type": "integer", "minimum": 64, "default": 1048576, "title": "Maximum frame size (bytes)" },
        "readTimeoutSec": { "type": "integer", "minimum": 0, "default": 0, "title": "Read timeout (s)", "description": "Close an idle stream connection after this long; 0 disables." },
        "allow": { "type": "array", "items": { "type": "string", "minLength": 1 }, "title": "Allowed senders", "description": "IP addresses or CIDR ranges allowed to send; empty allows anyone who can reach the port. UDP source addresses can be forged.", "x-showWhen": { "kind": ["tcpserver", "udp"] } },
        "maxConnections": { "type": "integer", "minimum": 0, "default": 50, "title": "Max connections", "description": "tcpserver: concurrent connections; 0 = unlimited", "x-showWhen": { "kind": "tcpserver" } },
        "maxMessagesPerSec": { "type": "integer", "minimum": 0, "default": 0, "title": "Max messages per second", "description": "tcpserver and udp: shared by every sender of the listener; 0 = unlimited", "x-showWhen": { "kind": ["tcpserver", "udp"] } },
        "tls": {
          "type": "object",
          "title": "TLS",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "requireClientCert": { "type": "boolean", "default": false, "title": "Require client certificates", "description": "Mutual TLS, verified against the clientCa secret. It applies to kind tcpserver only; the other kinds ignore it.", "x-showWhen": { "enabled": true } },
            "insecureSkipVerify": { "type": "boolean", "default": false },
            "serverName": { "type": "string" },
            "caFile": { "type": "string" },
            "certFile": { "type": "string" },
            "keyFile": { "type": "string" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "tcpclient" } }, "required": ["kind"] }, "then": { "required": ["address"] } },
        { "if": { "properties": { "kind": { "const": "tcpserver" } }, "required": ["kind"] }, "then": { "required": ["address"] } },
        { "if": { "properties": { "kind": { "const": "udp" } }, "required": ["kind"] }, "then": { "required": ["address"] } },
        { "if": { "properties": { "kind": { "const": "websocket" } }, "required": ["kind"] }, "then": { "required": ["url"] } },
        { "if": { "properties": { "kind": { "const": "mqtt" } }, "required": ["kind"] }, "then": { "required": ["brokerUrl", "topics"] } },
        { "if": { "properties": { "kind": { "const": "stomp" } }, "required": ["kind"] }, "then": { "required": ["brokerUrl", "queue"] } }
      ]
    },
    "framing": { "type": "string", "enum": ["line", "delimited", "lengthprefix", "beast", "xmlevent", "message"], "title": "Framing", "description": "How a byte stream is split into frames (stream transports); message transports deliver whole messages." },
    "decoder": {
      "type": "object",
      "title": "Decoder",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "enum": ["json", "nmea-gps", "nmea-ais", "cot", "sbs", "beast", "link16"], "title": "Format" },
        "options": { "type": "object", "title": "Decoder options" }
      }
    }
  },
  "x-secrets": {
    "tlsCert": { "title": "TLS certificate (PEM)" },
    "tlsKey": { "title": "TLS private key (PEM)" },
    "clientCa": { "title": "Client CA (PEM)", "showWhen": { "transport/kind": "tcpserver", "transport/tls/enabled": true, "transport/tls/requireClientCert": true }, "requiredWhen": { "transport/kind": "tcpserver", "transport/tls/enabled": true, "transport/tls/requireClientCert": true } },
    "serverCa": { "title": "Server CA (PEM)" }
  }
}
